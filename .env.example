# Base URL for the Inspirare API. Already includes /api.
# VITE_API_URL is also read (and takes priority) if you'd rather use that
# name — the client checks both, see src/api/client.js.
VITE_API_BASE_URL=https://inspirare-api.vercel.app/api

# ---------------------------------------------------------------------------
# Never add an AI provider key here.
#
# Vite inlines every VITE_* variable into the browser bundle, so anything in
# this file is public. The AI features (OpenRouter) need no client config at
# all: the browser only calls /api/ai/* on the backend, which holds the key.
#
# In particular, never create VITE_OPENROUTER_API_KEY or similar. If the AI
# needs configuring, set OPENROUTER_API_KEY in the *backend* .env instead
# (see backend/.env.example).
# ---------------------------------------------------------------------------
